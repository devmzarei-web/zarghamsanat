# Environment Variables - Copy to .env and fill in your values

# ============================================================
# DATABASE
# ============================================================
# PostgreSQL connection string
DATABASE_URI=postgresql://USER:PASSWORD@localhost:5432/zarghamsanat

# ============================================================
# PAYLOAD
# ============================================================
# Generate a strong secret: openssl rand -base64 32
PAYLOAD_SECRET=YOUR_SUPER_SECRET_KEY_CHANGE_THIS_IN_PRODUCTION

# The URL of the site (no trailing slash)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ============================================================
# NODE
# ============================================================
NODE_ENV=development
